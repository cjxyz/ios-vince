-void
+__attribute__((noreturn)) void
 vince_reboot_bootloader(void)
 {
 	uint8_t subtype = 0, rev2 = 0;
@@ -392,4 +400,35 @@ vince_reboot_bootloader(void)
 		__asm__ volatile ("wfi");
 	}
 }
+
+/*
+ * PE_halt_restart for this board. XNU's restarts and its panic restart go to fastboot, not back into Android: userdata
+ * holds the iOS root, so Android would hang there and leaving it needs the power button. After a panic the screen is
+ * kept for vincepanicwait seconds (default 20) so the panic text can be read or photographed. Halt goes to fastboot too
+ * (there is no power-off path here yet).
+ */
+static int
+vince_halt_restart(unsigned int type)
+{
+	switch (type) {
+	case kPEPanicRestartCPU: {
+		uint32_t wait_s = 20;
+
+		(void)PE_parse_boot_argn("vincepanicwait", &wait_s, sizeof(wait_s));
+		printf("VINCE: rebooting into fastboot in %u s\n", wait_s);
+		delay((int)(wait_s > 600 ? 600 : wait_s) * 1000000);
+		vince_reboot_bootloader();
+	}
+	case kPERestartCPU:
+	case kPEHaltCPU:
+	case kPEUPSDelayHaltCPU:
+		vince_reboot_bootloader();
+	case kPEHangCPU:
+		for (;;) {
+			__asm__ volatile ("wfi");
+		}
+	default:
+		return 0;               /* panic sync/begin/end, paging off: nothing to do */
+	}
+}
 #endif /* ARM64_BOARD_CONFIG_VINCE */
