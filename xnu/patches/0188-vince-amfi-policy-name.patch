diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
index 73afcef..5d4934b 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -305,8 +305,47 @@ sweet_sandbox_syscall(struct proc *p, int call, __unused user_addr_t arg)
 	}
 }
 
+/*
+ * __mac_syscall("AMFI", ...), from ios-casuarina topaz-0147 and topaz-0109 (APSL 2.0). Two callers look the
+ * policy up by that name:
+ * - dyld asks what it may do for the process it starts ({ u64 flags in, user pointer to u64 flags out }).
+ *   Without an answer it runs every platform binary restricted and ignores the DYLD_* variables, so the GPU's
+ *   OpenGL ES library never got into backboardd (DYLD_INSERT_LIBRARIES from userland/gpu/bbd_wrap.c).
+ * - libamfi (amfi_interface_query_bootarg_state() in ExtensionFoundation, ...): with no policy of that name lsd's
+ *   ExtensionKit said "Unable to find AMFI" and registered no app extension, PosterBoard (the wallpaper) included.
+ *   Those calls succeed and leave the caller's output alone; the first of each kind is logged.
+ */
+#define SWEET_AMFI_CHECK_DYLD_POLICY    0x5a
+#define SWEET_AMFI_DYLD_ALLOW_ALL       0xffULL
+
+static int
+sweet_amfi_syscall(__unused struct proc *p, int call, user_addr_t arg)
+{
+	uint64_t in_out[2] = { 0, 0 };
+	uint64_t allow = SWEET_AMFI_DYLD_ALLOW_ALL;
+	int error;
+
+	if (call != SWEET_AMFI_CHECK_DYLD_POLICY) {
+		static uint64_t seen;
+		if (call >= 0 && call < 64 && !(seen & (1ULL << call))) {
+			char name[32];
+
+			seen |= 1ULL << call;
+			proc_selfname(name, sizeof(name));
+			printf("SWEET AMFI: syscall %d from %s\n", call, name);
+		}
+		return 0;
+	}
+	error = copyin(arg, in_out, sizeof(in_out));
+	if (error == 0) {
+		error = copyout(&allow, (user_addr_t)in_out[1], sizeof(allow));
+	}
+	return error;
+}
+
 static const struct mac_policy_ops sweet_amfi_mac_ops = {
 	.mpo_vnode_check_signature = sweet_amfi_vnode_check_signature,
+	.mpo_policy_syscall = sweet_amfi_syscall,
 };
 
 /*
@@ -360,7 +399,7 @@ static struct mac_policy_conf sweet_sandbox_mac_conf = {
 static mac_policy_handle_t sweet_sandbox_mac_handle;
 
 static struct mac_policy_conf sweet_amfi_mac_conf = {
-	.mpc_name = "SWEET AMFI",
+	.mpc_name = "AMFI",                     /* the name dyld's and libamfi's __mac_syscall use */
 	.mpc_fullname = "SWEET built-in Mobile File Integrity",
 	.mpc_ops = &sweet_amfi_mac_ops,
 };
