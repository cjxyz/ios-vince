+static void
+adreno_main(void *param, wait_result_t wr)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(3000, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&adreno_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
